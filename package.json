{
  "name": "tender-flow",
  "private": true,
  "workspaces": [
    "mcp-service"
  ],
  "version": "1.9.25",
  "type": "module",
  "main": "desktop/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-public.mjs",
    "build:web": "vite build && node scripts/prerender-public.mjs",
    "build:local-assets": "npm run build:web && node scripts/verify-web-dist.mjs",
    "build:user-manual": "node scripts/build-user-manual.mjs",
    "build:icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "audit:architecture": "node scripts/audit-architecture-debt.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "check:legacy-structure": "node scripts/check-legacy-structure.mjs",
    "mcp:stdio": "node scripts/mcp-stdio.js",
    "mcp:canary:production": "node scripts/check-mcp-production.mjs",
    "desktop:install": "cd desktop && npm install --ignore-scripts",
    "desktop:compile": "node scripts/clean-desktop-dist.mjs && npm run desktop:install && cd desktop && tsc && cd .. && node scripts/write-desktop-build-env.mjs",
    "desktop:dev": "node scripts/assert-port-available.mjs 127.0.0.1 3000 && concurrently -k \"npm run dev -- --host 127.0.0.1 --port 3000 --strictPort\" \"wait-on tcp:3000 && npm run desktop:compile && electron .\"",
    "desktop:build": "cross-env ELECTRON_BUILD=true npm run build && cross-env ELECTRON_BUILD=true npm run desktop:compile && electron-builder --publish never",
    "desktop:build:mac": "npm run desktop:build -- --mac",
    "desktop:build:win": "npm run desktop:build -- --win",
    "version:patch": "npm version patch --no-git-tag-version && node scripts/sync-version.mjs",
    "version:minor": "npm version minor --no-git-tag-version && node scripts/sync-version.mjs",
    "version:major": "npm version major --no-git-tag-version && node scripts/sync-version.mjs",
    "release:assert-stable-version": "node scripts/assert-stable-version.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:prepare:stable": "npm run release:assert-stable-version && npm run release:prepare",
    "verify:web-dist": "node scripts/verify-web-dist.mjs",
    "release:verify-artifacts": "node scripts/verify-release-artifacts.mjs"
  },
  "dependencies": {
    "@appica/icons-react": "1.0.0",
    "@appica/ui-react": "1.1.0",
    "@google/genai": "^1.30.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@netlify/functions": "^5.2.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/papaparse": "^5.5.0",
    "busboy": "^1.6.0",
    "dompurify": "3.4.13",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.3",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.561.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/busboy": "^1.5.4",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^22.19.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "icon-gen": "^5.0.0",
    "jsdom": "^26.1.0",
    "marked": "^12.0.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.17",
    "typescript": "~6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.0",
    "wait-on": "^8.0.5"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": {
      "express": {
        "body-parser": "2.3.0"
      }
    },
    "@hono/node-server": "2.1.0",
    "axios": "1.19.0",
    "electron-builder": {
      "js-yaml": "4.3.1"
    },
    "es-module-lexer": "2.1.0",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "form-data": "4.0.6",
    "fast-uri": "3.1.7",
    "hono": "4.13.0",
    "ip-address": "10.4.0",
    "joi": "18.2.1",
    "qs": "6.15.2",
    "std-env": "4.1.0",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "ws": "8.21.0"
  }
}
